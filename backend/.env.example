# Sao chép thành backend/.env để chạy local. KHÔNG commit file .env.
# Production truyền các biến này qua Docker Compose (env_file), xem docs/adr/0006.

# --- Django
# Dev có khoá mặc định; production BẮT BUỘC, >= 50 ký tự:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database: bỏ trống ở local (SQLite db.sqlite3). CI / production: Postgres
# DATABASE_URL=postgres://bfc:password@localhost:5432/bfc_cms

# --- Wagtail
WAGTAILADMIN_BASE_URL=http://127.0.0.1:9000

# --- Bí mật ký request giữa CMS và frontend: webhook làm mới cache khi xuất bản (CMS → Next) và
# form Liên hệ (Next → CMS). CMS_SHARED_SECRET phải trùng CMS_SHARED_SECRET bên frontend/.env.local.
# Trống = không gọi webhook (web tự làm mới sau tối đa 1 giờ) và form Liên hệ không lưu được
CMS_SHARED_SECRET=
FRONTEND_REVALIDATE_URL=http://localhost:4000/api/revalidate

# --- Form Liên hệ: email nhận thông báo yêu cầu mới (cách nhau dấu phẩy). Chỉ dùng khi danh sách
# trong admin (Cài đặt → Liên hệ) để trống. Cả hai trống = không gửi email
# INQUIRY_NOTIFY_EMAILS=office@bfcfurniture.com

# --- Quét virus tệp đính kèm (ClamAV). Trống = không quét, tệp đánh dấu "Chưa quét" (máy dev).
# Production bắt buộc, vd tcp://clamav:3310 (container trong Compose)
# CLAMAV_URL=tcp://127.0.0.1:3310
# ATTACHMENT_SCAN_REQUIRED=false

# --- Dịch máy (wagtail-localize + Google Cloud Translation). Bỏ trống = dịch tay
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# --- Email (production). Local ghi email ra backend/tmp/emails
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=BFC CMS <no-reply@bfcfurniture.com>

LOG_LEVEL=INFO
