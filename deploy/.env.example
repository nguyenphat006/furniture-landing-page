# Sao chép thành deploy/.env trên server. KHÔNG commit file .env. Xem deploy/README.md.

# --- Domain (BFC chốt). Web và CMS tách subdomain, ví dụ:
WEB_DOMAIN=bfcfurniture.com
CMS_DOMAIN=cms.bfcfurniture.com

# --- Postgres
POSTGRES_DB=bfc_cms
POSTGRES_USER=bfc
# Sinh: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Bí mật chung web <-> CMS (webhook làm mới cache, form Liên hệ, xem trước bản nháp)
# Sinh: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CMS_SHARED_SECRET=

# --- Captcha Cloudflare Turnstile cho form Liên hệ (https://dash.cloudflare.com → Turnstile,
# thêm WEB_DOMAIN vào danh sách domain của widget). Thiếu thì form Liên hệ từ chối mọi yêu cầu.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Backup (deploy/backup.sh)
BACKUP_DIR=/var/backups/bfc-web
BACKUP_KEEP_DAYS=14
