# Sao chép thành deploy/.env.cms trên server: biến riêng của CMS (backend/config/settings/prod.py).
# Domain, Postgres, ClamAV, bí mật chung đã đặt trong docker-compose.yml từ deploy/.env.

# Sinh: python3 -c "import secrets; print(secrets.token_urlsafe(64))"   (>= 50 ký tự)
DJANGO_SECRET_KEY=

# Email gửi thông báo yêu cầu liên hệ (BFC cung cấp tài khoản SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BFC Website <no-reply@bfcfurniture.com>
# Ai nhận email khi có yêu cầu mới, khi admin chưa đặt ở Cài đặt → Liên hệ (cách nhau dấu phẩy)
INQUIRY_NOTIFY_EMAILS=

# Dịch máy (tuỳ chọn, backend/docs/adr/0003)
# GOOGLE_TRANSLATE_API_KEY=

LOG_LEVEL=INFO

# Ngôn ngữ của web (mặc định vi,en). Thêm mã mới cần bản frontend có ngôn ngữ đó
# CMS_LANGUAGES=vi,en
