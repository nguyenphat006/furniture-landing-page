# Captcha Cloudflare Turnstile cho form Liên hệ (https://dash.cloudflare.com → Turnstile)
# Khoá thử (luôn qua): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CMS (backend/, Django + Wagtail). Bỏ trống = dùng dữ liệu mock trong src/data/catalog.
# Local: chạy backend bằng `python -m uv run poe dev` (cổng 9000).
CMS_API_URL=
# CMS_API_URL=http://127.0.0.1:9000/api/v1
# Bí mật chung với CMS (cùng giá trị CMS_SHARED_SECRET bên backend), ký request hai chiều:
# CMS gọi /api/revalidate khi xuất bản, và form Liên hệ gửi yêu cầu sang CMS.
# Tên cũ CMS_REVALIDATE_SECRET vẫn đọc được.
CMS_SHARED_SECRET=

# Địa chỉ site thật, dùng cho canonical, hreflang, sitemap.xml, robots.txt (mặc định https://bfcfurniture.com)
# SITE_URL=https://bfcfurniture.com
